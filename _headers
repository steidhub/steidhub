# Editorial sources are public repository files, not search landing pages.
/seo/*
  X-Robots-Tag: noindex
/scripts/*
  X-Robots-Tag: noindex
/README.md
  X-Robots-Tag: noindex
/404.html
  X-Robots-Tag: noindex
# Imágenes, logos, videos y tipografías: caché de 7 días en el navegador
# (mejora la velocidad de carga, que Google mide en Core Web Vitals).
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
# Feed del blog
/blog/feed.xml
  Content-Type: application/rss+xml; charset=utf-8
